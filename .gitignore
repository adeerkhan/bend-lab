# Bend: binaries and build artifacts
*.gpu
*.bendtt
build/
dist/

# Local
.scratch/
.DS_Store

# the environment bend-env builds (the lock is committed, the env is not)
.bend/

# Python (reference/)
.venv/
__pycache__/
*.pyc

# downloaded data
data/
*.bin
reference/mamba3_data/
reference/mamba3_lm_data/

# bend-lint (make lint)
node_modules/

# the W&B cache; the reports themselves live in results/ and are committed
wandb/

# the dataset cache the runner fills (the hashes are in the manifests)
reference/.cache/

# the torch reference environment (reference/lucidrains)
.venv-lucidrains/
.venv-rf/
results/vit-logs/
results/lucidrains-rectified-flow/

# private, local-only
.local/
.ua/

# the understand skill's scratch files
.understand-anything/tmp/

# generated by reference/test_glm53_layers.py
examples/language/glm53_flash/data/

# the live trace is an observation, not a record
results/*/trace.jsonl

# the run store and its per-run traces: rebuilt by importing the latest trace
results/runs.sqlite3
results/runs.sqlite3-wal
results/runs.sqlite3-shm
results/*/runs/

# the background dashboard pid and log
results/dashboard.pid
results/dashboard.log
results/*/weights/

# named evaluation subsets (the flat weights are derived)
results/glm53-dense-ep*/
results/glm53-hybrid192-ep*/

# the step decoder writes the flat weights beside the evaluation
results/glm53-hybrid192-step-*/model-400/

# the batch target writes the combined eval here
results/glm53-hybrid192-step/
